# 复制为 .env 使用（.env 不入库）。来源：docs/architecture/system-design.md §6。
# 安全约束（技术规范 §66）：所有密钥只存在于服务端环境；禁止任何 NEXT_PUBLIC_* 变量。

# Postgres + pgvector（infra/compose/docker-compose.yml 的连接串；asyncpg 异步驱动）
DATABASE_URL=postgresql+asyncpg://h2copilot:h2copilot@localhost:5432/h2copilot

# 对象存储：留空 = LocalFS（ADR-0007，MVP 用本地卷 data/storage/）
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=

# 模型提供方（Phase 5 前可为空；百炼 Key 由用户以 .env.local 注入，见 Q-010）
LLM_PROVIDER=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RERANK_PROVIDER=
RERANK_MODEL=

# Admin 密码（上传/文档管理路由的访问口令，Phase 5 启用校验）
ADMIN_PASSWORD=

# Langfuse（可空：MVP 不启用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
